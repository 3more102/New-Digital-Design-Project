# =============================================================================
# Yosys synthesis script - Timer/Counter Subsystem
# Run from the synth/ directory: yosys -s synth_yosys.ys
# =============================================================================

# SystemVerilog RTL
read_verilog -sv ../rtl/prescaler.sv
read_verilog -sv ../rtl/counter.sv
read_verilog -sv ../rtl/compare_unit.sv
read_verilog -sv ../rtl/pwm_generator.sv
read_verilog -sv ../rtl/input_capture.sv
read_verilog -sv ../rtl/cascade_unit.sv
read_verilog -sv ../rtl/register_block.sv
read_verilog -sv ../rtl/interrupt_controller.sv
read_verilog -sv ../rtl/timer_top.sv

hierarchy -check -top timer_top

proc
opt
fsm
opt
memory
opt
techmap
opt
clean

check
stat

write_verilog output/timer_top_netlist.v
write_blif output/timer_top.blif
